# ====== Frontend (aman dipublikasikan, diawali VITE_) ======
# Opsional. Tanpa ini & tanpa Redis → mode DEMO (ucapan tersimpan di browser saja).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Alternatif gratis: URL Web App Google Apps Script (lihat apps-script/Code.gs)
VITE_SHEETS_URL=

# ====== Server only (Vercel → Settings → Environment Variables) ======
# Paling mudah: Vercel → Storage → Create Database → Upstash for Redis → Connect
# (dua variabel ini terisi OTOMATIS, tidak perlu diketik)
KV_REST_API_URL=
KV_REST_API_TOKEN=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Password halaman /admin
ADMIN_PASSWORD=
# Opsional: string acak panjang (mis. `openssl rand -hex 32`). Bila kosong memakai ADMIN_PASSWORD.
APP_SECRET=
