# ====== Frontend (aman dipublikasikan, diawali VITE_) ======
# Isi salah satu backend. Jika keduanya kosong → mode DEMO (ucapan tersimpan di browser saja).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Alternatif gratis: URL Web App Google Apps Script (lihat apps-script/Code.gs)
VITE_SHEETS_URL=

# ====== Server only (Vercel → Settings → Environment Variables) ======
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Password halaman /admin
ADMIN_PASSWORD=
# String acak panjang untuk menandatangani sesi admin & hash IP (mis. hasil `openssl rand -hex 32`)
APP_SECRET=
